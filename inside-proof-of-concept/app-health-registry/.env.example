# Copy this file to .env in this directory, then restart the service.
# Existing process environment variables take precedence over these values.
HEALTH_REGISTRY_SERVICE_PORT=8100

# Optional: defaults to inside-proof-of-concept/metrics/all_metrics.csv.
# Prefer an absolute path; relative paths remain relative to the working directory.
# METRICS_FILE=/absolute/path/to/health-registry-metrics.csv
